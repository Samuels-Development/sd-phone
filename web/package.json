{
    "name": "sd-phone-ui",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && tsc -p src/sdk && vite build && node scripts/check-build.mjs",
        "build:demo": "tsc --noEmit && tsc -p src/sdk && vite build --mode demo && node scripts/check-build.mjs build-demo",
        "preview": "vite preview",
        "lint": "oxlint src",
        "test": "vitest run --passWithNoTests",
        "knip": "knip",
        "i18n:check": "node scripts/i18n.mjs check",
        "i18n:gen": "node scripts/i18n.mjs gen",
        "i18n:status": "node scripts/i18n.mjs status",
        "i18n:prune": "node scripts/i18n.mjs prune",
        "check": "npm run -s build && npm run -s lint && npm run -s test && npm run -s knip && npm run -s i18n:check"
    },
    "dependencies": {
        "@fontsource/great-vibes": "^5.3.0",
        "@fontsource/inter": "^5.3.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "html2canvas": "^1.4.1",
        "lucide-react": "^1.64.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "zustand": "^5.0.16"
    },
    "devDependencies": {
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "autoprefixer": "^10.6.2",
        "knip": "^6.43.0",
        "oxlint": "^1.90.0",
        "playwright": "^1.64.1",
        "postcss": "^8.5.32",
        "tailwindcss": "^3.4.19",
        "typescript": "^7.0.2",
        "vite": "^8.3.5",
        "vitest": "^4.1.12"
    },
    "license": "GPL-3.0-or-later"
}
